# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Gmail (or any SMTP) credentials used to send OTP emails
# For Gmail: enable 2FA on the account, then create an "App Password" and use that here —
# your normal Gmail password will NOT work with Nodemailer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---- ESP32 hardware link ----
# Shared secret the ESP32 sends in the X-Device-Key header. Put the SAME value in the
# sketch's DEVICE_KEY. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=change_this_to_a_random_hex_string

# How many litres per minute come out of your drip line with the valve open.
# Measure it: open the valve for exactly 60 s into a measuring container. Used to turn
# "water 2 L" into a valve-open time.
VALVE_FLOW_LPM=2

# Safety cap: no single valve run (auto or manual) lasts longer than this many seconds.
VALVE_MAX_SECONDS=600
